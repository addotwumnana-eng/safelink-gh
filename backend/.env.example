# Paystack (use test keys for development)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

PORT=3001
NODE_ENV=development

# Frontend URL used as Paystack callback_url after payment.
# Development: http://localhost:5173
# Production / mobile app: your deployed frontend URL (e.g. https://safelink-ghana.vercel.app)
# Required for the app's "return to app" flow after Paystack payment.
FRONTEND_URL=http://localhost:5173

DATABASE_PATH=./data/deals.json

# Escrow settlement mode:
# - enabled  => attempt live Paystack transfer/refund when possible
# - disabled => keep status updates but run in simulated mode (no money movement)
PAYSTACK_ESCROW_ACTIONS=enabled

# Required when paying sellers to Ghana mobile money without a pre-created recipient code.
# Example: use Paystack List Banks endpoint filtered by currency=GHS to find valid mobile money bank code.
PAYSTACK_GH_MOBILE_MONEY_BANK_CODE=

# Optional: if set, this recipient code is used for release payouts.
# PAYSTACK_TRANSFER_RECIPIENT_CODE=RCP_xxxxx
